# ==============================================================================
# VAPS Kiosk API Configuration (Environment Template)
# ==============================================================================
LOGIN_URL=https://madhuvanvatikacloud.com:21093/
PORTAL_URL=https://madhuvanvatikacloud.com:21105/
LOGIN_MI_ID=31
INST_CODE_BGIMAGE=MVPS

# ==============================================================================
# External Backend VAPS Facade API Endpoints
# ==============================================================================
# 1. Login Authentication Endpoint
API_VAPS_LOGIN=https://madhuvanvatikacloud.com:21093/api/LoginFacade/

# 2. Student Attendance Ledger Endpoint
API_VAPS_STUDENT_ATTENDANCE=https://madhuvanvatikacloud.com:21105/api/StudentDashboardFacade/Getdetails/

# 3. Student Timetable Endpoint
API_VAPS_STUDENT_TIMETABLE=https://madhuvanvatikacloud.com:21105/api/Student_TTFacade/getStudentTT/

# 4. Student Exam Schedule & List Endpoint
API_VAPS_EXAM_LIST=https://madhuvanvatikacloud.com:21105/api/ExamReportFacade/getexamdata/

# 5. Student Exam Evaluation Marks Endpoint
API_VAPS_EXAM_DETAILS=https://madhuvanvatikacloud.com:21105/api/ExamReportFacade/StudentExamDetails/

# ==============================================================================
# Internal Next.js Client API Routes
# ==============================================================================
NEXT_PUBLIC_LOGIN_URL=https://madhuvanvatikacloud.com:21093/
NEXT_PUBLIC_LOGIN_MI_ID=31

NEXT_PUBLIC_API_LOGIN=/api/login
NEXT_PUBLIC_API_ATTENDANCE=/api/student/attendance
NEXT_PUBLIC_API_TIMETABLE=/api/student/timetable
NEXT_PUBLIC_API_EXAM=/api/student/exam

# ==============================================================================
# AI Chatbot & Agent LLM Engines (Groq + NVIDIA)
# ==============================================================================
# 1. Groq Cloud API (Fast Conversational Response & Planning)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=openai/gpt-oss-120b

# 2. NVIDIA NIM Cloud (Deep Thinking, Predictions & Recommendations)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_REASONING_EFFORT=max
NVIDIA_MAX_TOKENS=16384

